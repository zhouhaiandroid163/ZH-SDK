<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout style="@style/help_ll">

        <CheckBox
            android:id="@+id/cbTop"
            style="@style/help_cx"
            android:text="@string/fun_sw_sleep" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivHelp"
            style="@style/help_iv" />

    </LinearLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llBottom"
        style="@style/public_lin01"
        tools:visibility="gone">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGetSleepState"
            style="@style/public_button"
            android:text="@string/btn_get_sleep_state" />

        <CheckBox
            android:id="@+id/cbDisablePeriodFinetuning"
            style="@style/public_checkbox"
            android:text="@string/btn_disable_period_finetuning" />

        <CheckBox
            android:id="@+id/cbDisableAutoDetection"
            style="@style/public_checkbox"
            android:text="@string/btn_disable_auto_detection" />

        <CheckBox
            android:id="@+id/cbDisableCombine"
            style="@style/public_checkbox"
            android:text="@string/btn_disable_combine" />



        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/public_input_lin"
            android:orientation="vertical"
            android:layout_height="wrap_content"
            >

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/public_textview01"
                android:text="@string/sw_min_nap_length" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etMinNapLength"
                style="@style/public_edit_number"
                />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/public_input_lin"
            android:orientation="vertical"
            android:layout_height="wrap_content"
            >

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/public_textview01"
                android:text="@string/sw_max_gap_length" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etMaxGapLength"
                style="@style/public_edit_number"
                />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/public_input_lin"
            android:orientation="vertical"
            android:layout_height="wrap_content"
            >

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/public_textview01"
                android:text="@string/sw_long_sleep_period_start" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etLongSleepPeriodStart"
                style="@style/public_edit_number"
                />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/public_input_lin"
            android:orientation="vertical"
            android:layout_height="wrap_content"
            >

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/public_textview01"
                android:text="@string/sw_long_sleep_period_end" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etLongSleepPeriodEnd"
                style="@style/public_edit_number"
                />

        </androidx.appcompat.widget.LinearLayoutCompat>



        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSetSleepConfig"
            style="@style/public_button"
            android:text="@string/btn_set_sleep_config" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGetSleepConfig"
            style="@style/public_button"
            android:text="@string/btn_get_sleep_config" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>