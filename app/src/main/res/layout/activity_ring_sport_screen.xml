<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/layoutLog"
        layout="@layout/public_item_log" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="50dp"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGetSportState"
                style="@style/public_button"
                android:text="@string/get_device_sport_state" />

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/public_input_lin"
                android:layout_marginTop="20dp">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/public_textview01"
                    android:text="@string/input_sport_type" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etSportType"
                    style="@style/public_edit_number" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat style="@style/public_input_lin">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/public_textview01"
                    android:text="@string/input_connect_state" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvConnectState"
                    style="@style/public_textview02" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat style="@style/public_input_lin">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/public_textview01"
                    android:text="@string/input_sport_state" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSportState"
                    style="@style/public_textview02" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat style="@style/public_input_lin">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/public_textview01"
                    android:text="@string/input_sport_data" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvWearData"
                    style="@style/public_textview02" />

            </androidx.appcompat.widget.LinearLayoutCompat>


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnStart"
                style="@style/public_button"
                android:text="@string/btn_start" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPause"
                style="@style/public_button"
                android:text="@string/btn_pause" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnResume"
                style="@style/public_button"
                android:text="@string/btn_continue" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEnd"
                style="@style/public_button"
                android:text="@string/btn_end" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#d0d0d0"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnIsAuto"
                style="@style/public_button"
                android:text="@string/btn_is_auto" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#d0d0d0"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                />

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/public_input_lin"
                android:layout_marginTop="20dp">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/public_textview01"
                    android:text="@string/input_walk_start_duration" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etWalkStartDuration"
                    style="@style/public_edit_number" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- New input fields for other durations and threshold -->
            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/public_input_lin"
                android:layout_marginTop="10dp">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/public_textview01"
                    android:text="@string/input_run_start_duration" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etRunStartDuration"
                    style="@style/public_edit_number" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/public_input_lin"
                android:layout_marginTop="10dp">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/public_textview01"
                    android:text="@string/input_cycling_start_duration" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etCyclingStartDuration"
                    style="@style/public_edit_number" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/public_input_lin"
                android:layout_marginTop="10dp">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/public_textview01"
                    android:text="@string/input_elliptical_start_duration" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etEllipticalStartDuration"
                    style="@style/public_edit_number" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/public_input_lin"
                android:layout_marginTop="10dp">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/public_textview01"
                    android:text="@string/input_rowing_start_duration" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etRowingStartDuration"
                    style="@style/public_edit_number" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/public_input_lin"
                android:layout_marginTop="10dp">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/public_textview01"
                    android:text="@string/input_walk_end_duration" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etWalkEndDuration"
                    style="@style/public_edit_number" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/public_input_lin"
                android:layout_marginTop="10dp">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/public_textview01"
                    android:text="@string/input_run_end_duration" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etRunEndDuration"
                    style="@style/public_edit_number" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/public_input_lin"
                android:layout_marginTop="10dp">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/public_textview01"
                    android:text="@string/input_cycling_end_duration" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etCyclingEndDuration"
                    style="@style/public_edit_number" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/public_input_lin"
                android:layout_marginTop="10dp">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/public_textview01"
                    android:text="@string/input_elliptical_end_duration" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etEllipticalEndDuration"
                    style="@style/public_edit_number" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/public_input_lin"
                android:layout_marginTop="10dp">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/public_textview01"
                    android:text="@string/input_rowing_end_duration" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etRowingEndDuration"
                    style="@style/public_edit_number" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/public_input_lin"
                android:layout_marginTop="10dp">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/public_textview01"
                    android:text="@string/input_ratio_threshold" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etRatioThreshold"
                    style="@style/public_edit_number" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSetAutoConfig"
                style="@style/public_button"
                android:text="@string/btn_set_auto_config" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGetAutoConfig"
                style="@style/public_button"
                android:text="@string/btn_get_auto_config" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </ScrollView>

</androidx.appcompat.widget.LinearLayoutCompat>