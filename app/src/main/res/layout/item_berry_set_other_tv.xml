<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout style="@style/help_ll">

        <CheckBox
            android:id="@+id/cbTop"
            style="@style/help_cx"
            android:text="@string/other_tv_berry" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivHelp"
            style="@style/help_iv" />

    </LinearLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llBottom"
        style="@style/public_lin01"
        tools:visibility="visible">

<!--        <androidx.appcompat.widget.LinearLayoutCompat style="@style/public_input_lin">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/public_textview01"
                android:text="@string/tv_device_id" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etDeviceId"
                style="@style/public_edit_str" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat style="@style/public_input_lin">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/public_textview01"
                android:text="@string/tv_device_name" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etName"
                style="@style/public_edit_str" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfig"
            style="@style/public_button"
            android:text="@string/tv_set_config" />-->

        <androidx.appcompat.widget.LinearLayoutCompat style="@style/public_input_lin">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/public_textview01"
                android:text="@string/tv_active_id" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etActiveId"
                style="@style/public_edit_str" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat style="@style/public_input_lin">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/public_textview01"
                android:text="@string/tv_device_id" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etDeviceIdList"
                style="@style/public_edit_str"
                android:hint="@string/tv_list_id_hint"
                android:textSize="14sp"
                />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat style="@style/public_input_lin">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/public_textview01"
                android:text="@string/tv_device_name" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etNameList"
                style="@style/public_edit_str"
                android:hint="@string/tv_list_name_hint"
                android:textSize="14sp"
                />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnList"
            style="@style/public_button"
            android:text="@string/tv_set_list" />

        <androidx.appcompat.widget.LinearLayoutCompat style="@style/public_input_lin">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/public_textview01"
                android:text="@string/tv_set_error" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etError"
                style="@style/public_edit_number" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnError"
            style="@style/public_button"
            android:text="@string/tv_set_error" />



        <androidx.appcompat.widget.LinearLayoutCompat style="@style/public_input_lin">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/public_textview01"
                android:text="@string/tv_tv_index" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etTvIndex"
                style="@style/public_edit_number"
                android:hint="@string/tv_tv_index"
                android:textSize="14sp"
                />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat style="@style/public_input_lin">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/public_textview01"
                android:text="@string/tv_tv_name" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etTvName"
                style="@style/public_edit_str"
                android:hint="@string/tv_tv_name"
                android:textSize="14sp"
                />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <include
            android:id="@+id/iconFileSelect"
            layout="@layout/public_select_file"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnIcons"
            style="@style/public_button"
            android:text="@string/tv_set_tv_icons" />

    </androidx.appcompat.widget.LinearLayoutCompat>


</androidx.appcompat.widget.LinearLayoutCompat>